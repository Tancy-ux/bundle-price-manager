{
  "name": "bundle-price-manager",
  "version": "1.0.0",
  "description": "Local bundle price manager — keeps bundle prices in sync with component prices. Data saved to data/data.json on disk.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "import": "node import-csv.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "pull": "node --env-file=.env scripts/pull.js",
    "sync-store": "node --env-file=.env scripts/sync-store.js",
    "fetch-stock": "node --env-file=.env scripts/fetch-stock.js"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.3",
    "@vercel/edge": "^1.2.1",
    "express": "^4.22.2"
  }
}
